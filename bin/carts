#!/usr/bin/env bash
# Open Cart's Tasks and Calendar: the calendar, tasks and contacts app (a
# standalone Quickshell process).
#
#   carts [KEY [VIEW]]     open/focus, optionally on a day (yyyy-MM-dd)
#                          and view (month|week|day|agenda|year)
#   carts --new            open with a new-event form
#   carts --tasks [VIEW]   open on the tasks, optionally on a smart list
#                          (today|scheduled|all|important|completed)
#   carts --new-task       open with a new-task form
#   carts --task LIST|UID  open a task in the editor
#   carts --add TEXT       add a task to the running app, e.g. from a key binding:
#                          carts --add "Call the bank tomorrow 9am !high"
#   carts --contacts       open on the contacts
#   carts --toggle         open, or quit if it is running
#   carts --quit
#   carts --install        add the app to the launcher and `carts` to ~/.local/bin
set -euo pipefail

here=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
config="$here/CalendarApp.qml"
shell_dir="${OMARCHY_PATH:-/usr/share/omarchy}/shell"

# The views import Omarchy's qs.Commons / qs.Ui, which must sit inside the
# config folder. Link them (gitignored), repairing stale links after moves.
for m in Commons Ui; do
  if [[ "$(readlink "$here/$m" 2>/dev/null)" != "$shell_dir/$m" ]]; then
    [[ -e "$here/$m" && ! -L "$here/$m" ]] && { echo "carts: $here/$m is not a symlink; refusing to replace it" >&2; exit 1; }
    ln -sfn "$shell_dir/$m" "$here/$m"
  fi
done

ipc() { quickshell ipc -p "$config" call carts "$@" >/dev/null 2>&1; }
running() { quickshell list -p "$config" 2>/dev/null | grep -q 'Instance'; }

# The same entry the bar plugin writes (Service.qml), so the two agree.
install_app() {
  local apps="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
  local file="$apps/carts.desktop" bin="$HOME/.local/bin"
  if [[ -e $file ]] && ! grep -q 'X-Carts-Managed=true' "$file"; then
    echo "carts: $file exists and is not ours; leaving it alone" >&2
  else
    mkdir -p "$apps"
    printf '%s\n' "[Desktop Entry]" "Type=Application" "Name=Cart's Tasks and Calendar" \
      "GenericName=Calendar and Tasks" "Comment=Calendar, tasks and contacts for Omarchy" \
      "Exec=\"$here/bin/carts\"" "Icon=x-office-calendar" "Categories=Office;Calendar;" \
      "Keywords=calendar;events;agenda;schedule;tasks;todo;reminders;contacts;" \
      "StartupWMClass=org.omarchy.carts" "NoDisplay=false" "X-Carts-Managed=true" >"$file"
    echo "Added $file"
  fi
  mkdir -p "$bin"
  if [[ -e $bin/carts && "$(readlink -f "$bin/carts")" != "$here/bin/carts" ]]; then
    echo "carts: $bin/carts exists and is something else; leaving it alone" >&2
  else
    ln -sfn "$here/bin/carts" "$bin/carts"
    echo "Linked $bin/carts"
  fi
}

mode=open
case "${1:-}" in
  --install) install_app; exit 0 ;;
  --new) mode=new; shift ;;
  --contacts) mode=contacts; shift ;;
  --tasks) mode=tasks; shift ;;
  --new-task) mode=newtask; shift ;;
  --task) mode=task; shift ;;
  --add) mode=add; shift ;;
  --toggle) mode=toggle; shift ;;
  --quit) ipc quit || true; exit 0 ;;
  -h|--help) sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
esac

if [[ $mode == add ]]; then
  text="$*"
  [[ -n $text ]] || { echo "usage: carts --add TEXT" >&2; exit 2; }
  running || { echo "carts: the app is not running; open it first (adding needs its task store)" >&2; exit 1; }
  err=$(quickshell ipc -p "$config" call carts add "$text" 2>&1) || { echo "carts: $err" >&2; exit 1; }
  [[ -z $err ]] || { echo "carts: $err" >&2; exit 1; }
  exit 0
fi

key=${1:-}
view=${2:-}

if running; then
  case $mode in
    toggle) ipc quit; exit 0 ;;
    new) ipc newEvent && exit 0 ;;
    contacts) ipc contacts && exit 0 ;;
    tasks) ipc tasks "$key" && exit 0 ;;
    newtask) ipc newTask && exit 0 ;;
    task) ipc openTask "$key" && exit 0 ;;
    *) ipc present "$key" "$view" && exit 0 ;;
  esac
fi

export QS_APP_ID=org.omarchy.carts
export CARTS_KEY="$key" CARTS_VIEW="$view"
[[ $mode == new ]] && export CARTS_NEW=1
[[ $mode == contacts ]] && export CARTS_MODE=contacts
if [[ $mode == tasks || $mode == newtask || $mode == task ]]; then
  export CARTS_MODE=tasks CARTS_KEY="" CARTS_VIEW=""
  [[ $mode == tasks ]] && export CARTS_TASK_VIEW="$key"
  [[ $mode == newtask ]] && export CARTS_NEW_TASK=1
  [[ $mode == task ]] && export CARTS_TASK="$key"
fi
# -n: a second launch racing this one exits instead of opening a twin.
exec quickshell -n -d -p "$config" >/dev/null 2>&1
